# Postgres (Supabase). For production/serverless, prefer the pooled connection
# string (port 6543 / pgbouncer) instead of the direct port 5432 connection.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Mini admin panel auth (single admin user)
ADMIN_USERNAME=admin
# bcrypt hash of the admin password (generate with bcryptjs, never commit a plain password)
ADMIN_PASSWORD_HASH=
# Long random string used to sign admin session JWTs
JWT_SECRET=

# Supabase Storage (S3-compatible) — used for admin image uploads
S3_BUCKET_NAME=magiancestral-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-1
# Optional: override the public URL base used to build uploaded image URLs
# if it can't be reliably derived from S3_ENDPOINT_URL.
# S3_PUBLIC_URL_BASE=https://<project-ref>.storage.supabase.co/storage/v1/object/public
